/* ---------------------------------------------------------------------------
   style.zcss — the only stylesheet the site links.

   Naming, in one paragraph:

     tokens     `color-*`, `font-*`, `width-*` — what the value is for, not
                what it looks like. `color-text` never becomes a lie when the
                palette changes.
     blocks     one noun per component: `layout`, `header`, `main`, `footer`,
                `entry`, `post-list`, `pager`, `term-list`, `archive`.
     elements   `block__part`: `.header__nav`, `.entry__title`.
     modifiers  `block__part--state`: `.pager__step--disabled`.

   Every class name in this file is emitted by exactly one place:
   _includes/ (leaf components), _layouts/ (page frames) or a content page.
   Renaming a class means updating that one producer.

   ZCSS is a CSS superset — F#-style `let` bindings, nesting-free rule blocks
   in square brackets — compiled to plain CSS at build time. The build writes
   the compiled result next to this file as style.css.

   Register this file in src/Zest.App/Zest.App.csproj so that `zest init`
   copies it into new sites.
   --------------------------------------------------------------------------- */

/* -- Tokens ---------------------------------------------------------------
   Colours, font stacks and the reading width. The font stacks are system
   fonts only: no webfont request ever leaves the reader's machine. */

let color-bg      = #ffffff
let color-text    = #1c1c1a
let color-muted   = #6f6f68
let color-accent  = #0b5394
let color-surface = #f6f6f2
let color-border  = #e3e3de
let font-body     = system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif
let font-code     = ui-monospace, 'SF Mono', 'Cascadia Mono', Consolas, 'Liberation Mono', monospace
let width-content = 40rem

/* -- Reset and document typography --------------------------------------- */

*, *:before, *:after [
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 0;
]

/* Reserve the scrollbar track on every page, not just the long ones. The
   gutter is part of the viewport instead of appearing when content overflows,
   so moving between a short page and a long one never shifts the column
   sideways by the width of the bar. */
html [
  overflow-y: scroll;
]

body [
  background: color-bg;
  color: color-text;
  font-family: font-body;
  font-size: 1rem;
  line-height: 1.7;
  overflow-wrap: break-word;
  -webkit-font-smoothing: antialiased;
]

/* Vertical rhythm is margin-top only, so the first block on a page never
   opens with a gap and no rule needs a matching margin-bottom.

   Headings take two steps: a larger one that separates a new section from the
   text above it, and a small one that closes the gap to the block below. Both
   stay close to one line of body text, so a section break reads as a break and
   not as a hole. */
h1, h2, h3, h4, h5, h6 [
  margin-top: 2rem;
  line-height: 1.25;
  font-weight: 600;
]

h3, h4, h5, h6 [
  margin-top: 1.375rem;
]

h1 + *, h2 + *, h3 + *, h4 + * [
  margin-top: 0.375rem;
]

h1 [ font-size: 1.75rem; ]
h2 [ font-size: 1.375rem; ]
h3 [ font-size: 1.125rem; ]
h4 [ font-size: 1rem; ]

p, ul, ol, blockquote, pre, table, figure [
  margin-top: 1rem;
]

ul, ol [
  padding-left: 1.5rem;
]

/* A little air between items makes a list scannable without turning it into a
   stack of paragraphs. Nested lists stay tight to their parent item. */
li + li [
  margin-top: 0.375rem;
]

li > ul, li > ol [
  margin-top: 0.375rem;
]

a [
  color: color-accent;
  text-decoration: none;
]

a:hover [
  text-decoration: underline;
  text-underline-offset: 2px;
]

::focus-visible [
  outline: 2px solid color-accent;
  outline-offset: 2px;
]

img, svg [
  display: block;
  max-width: 100%;
]

img [
  height: auto;
]

blockquote [
  background: color-surface;
  margin-top: 1.5rem;
  padding: 0.875rem 1.125rem;
  border-left: 3px solid color-border;
  color: color-muted;
]

blockquote > :first-child [
  margin-top: 0;
]

code, pre [
  font-family: font-code;
  background: color-surface;
]

/* Inline code sits inside prose, so it is sized relative to its own line and
   padded in ems: the line box does not jump when a word is marked up. */
code [
  padding: 0.125em 0.375em;
  font-size: 0.875em;
  border-radius: 3px;
]

/* Block code is a panel: its own size, a hairline border to separate it from
   the page, and enough leading that wrapped long lines stay readable. */
pre [
  padding: 1rem 1.125rem;
  overflow-x: auto;
  font-size: 0.875rem;
  line-height: 1.65;
  border: 1px solid color-border;
  border-radius: 4px;
  tab-size: 2;
]

/* `pre code` resets font-size to 1em, otherwise the inline-code rule would
   scale the block's text a second time. */
pre code [
  background: transparent;
  padding: 0;
  font-size: 1em;
]

hr [
  border-top: 1px solid color-border;
  margin: 2.5rem 0;
]

table [
  width: 100%;
  margin-top: 1.5rem;
  border-collapse: collapse;
  border-bottom: 2px solid color-text;
  font-size: 0.9375rem;
]

thead th [
  border-bottom: 1px solid color-text;
]

th, td [
  padding: 0.5rem 0.75rem;
  text-align: left;
  border-bottom: 1px solid color-border;
]

/* -- Layout ---------------------------------------------------------------
   The page frame: header, main column and footer, stacked as a column so the
   footer sits at the bottom of a short page. Emitted by _layouts/shell.html. */

.layout [
  display: flex;
  flex-direction: column;
  min-height: 100vh;
]

.main [
  flex: 1;
  width: 100%;
  max-width: width-content;
  margin: 0 auto;
  padding: 2.5rem 1.5rem 4rem;
]

/* -- Header ---------------------------------------------------------------
   Brand and navigation. Emitted by _includes/header.html. */

.header [
  width: 100%;
  max-width: width-content;
  margin: 0 auto;
  padding: 1.25rem 1.5rem 1rem;
  border-bottom: 1px solid color-border;
]

.header__inner [
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
]

.header__brand [
  color: color-text;
  font-size: 1rem;
  font-weight: 600;
  letter-spacing: 0.01em;
]

.header__brand:hover [
  text-decoration: none;
]

.header__nav [
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  font-size: 0.875rem;
]

/* -- Footer ---------------------------------------------------------------
   Copyright and feed link. Emitted by _includes/footer.html. */

.footer [
  width: 100%;
  max-width: width-content;
  margin: 0 auto;
  padding: 1.25rem 1.5rem 2.5rem;
  border-top: 1px solid color-border;
  color: color-muted;
  font-size: 0.8125rem;
]

.footer__inner [
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 0.25rem 1rem;
]

.footer__text [
  margin: 0;
]

/* -- Entry ----------------------------------------------------------------
   One page of content: title, meta line, body, and the footer a dated entry
   adds (tags, category, way back). Emitted by _layouts/default.html and
   _layouts/post.html. */

.entry__header [
  margin-bottom: 1.75rem;
]

/* The page title closes the frame rather than opening a section: it takes no
   top margin of its own, so the header padding is the only gap above it. */
.entry__title [
  margin-top: 0;
  font-size: 1.75rem;
  line-height: 1.3;
]

.entry__meta [
  margin-top: 0.5rem;
  font-size: 0.875rem;
  color: color-muted;
]

.entry__body [
  word-wrap: break-word;
]

/* The header already supplies the gap above the body; a leading paragraph or
   heading must not add its own. */
.entry__body > :first-child [
  margin-top: 0;
]

.entry__footer [
  margin-top: 2.5rem;
  padding-top: 1rem;
  border-top: 1px solid color-border;
  font-size: 0.875rem;
  color: color-muted;
]

.entry__tags [
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 0.25rem 0.75rem;
  margin-top: 0.5rem;
]

.entry__tag-label [
  color: color-muted;
  font-variant: small-caps;
  letter-spacing: 0.04em;
]

.entry__nav [
  margin-top: 1rem;
]

/* -- Intro ----------------------------------------------------------------
   The lead paragraph above a listing. Emitted by content/index.zest.fsx and
   the tag / category indexes. */

.intro [
  margin-bottom: 2rem;
  color: color-muted;
]

/* -- Post list ------------------------------------------------------------
   Date, title and excerpt per entry, separated by rules. Emitted by
   _includes/post-list.html (Zestucks) and content/index.zest.fsx (F#); the
   class names are the contract between the two. */

.post-list [
  list-style: none;
  padding-left: 0;
]

.post-list__item [
  padding: 1.125rem 0;
  border-top: 1px solid color-border;
]

.post-list__item:first-child [
  border-top: 0;
  padding-top: 0;
]

.post-list__date [
  display: block;
  font-size: 0.8125rem;
  color: color-muted;
  font-variant-numeric: tabular-nums;
]

.post-list__title [
  font-size: 1.25rem;
  margin-top: 0.125rem;
]

.post-list__excerpt [
  margin-top: 0.375rem;
  font-size: 0.9375rem;
  color: color-muted;
]

/* -- Pager ----------------------------------------------------------------
   Newer / page N of M / older. A step with nowhere to go is disabled, so the
   pager never promises a page that does not exist. Emitted by
   _includes/pager.html and content/index.zest.fsx. */

.pager [
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 1rem;
  margin-top: 2.5rem;
  padding-top: 1rem;
  border-top: 1px solid color-border;
  font-size: 0.875rem;
]

.pager__status [
  color: color-muted;
  font-variant-numeric: tabular-nums;
]

.pager__step--disabled [
  color: color-muted;
]

/* -- Term list ------------------------------------------------------------
   The tag and category index: one chip per term. Emitted by
   _layouts/tags.html and _layouts/categories.html. */

.term-list [
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  list-style: none;
  padding-left: 0;
]

.term-list__item a [
  display: inline-block;
  padding: 0.25rem 0.625rem;
  border: 1px solid color-border;
  border-radius: 3px;
  font-size: 0.875rem;
]

.term-list__item a:hover [
  background: color-surface;
  text-decoration: none;
]

/* -- Archive --------------------------------------------------------------
   Posts grouped by year. Emitted by content/archive.zest.fsx. */

.archive__year [
  margin-top: 2rem;
]

.archive__year:first-child [
  margin-top: 0;
]

/* The section supplies the gap above a year; the heading inside it must not
   add a second one. */
.archive__year > :first-child [
  margin-top: 0;
]

/* -- Responsive, print and motion preferences ------------------------------
   The print rules are the quiet payoff: the chrome disappears and the page
   prints as a clean document. */

@media (max-width: 640px) [
  .main [
    padding-left: 1rem;
    padding-right: 1rem;
  ]

  .header, .footer [
    padding-left: 1rem;
    padding-right: 1rem;
  ]

  table [
    display: block;
    overflow-x: auto;
  ]
]

@media print [
  .header, .footer, .entry__footer, .pager [
    display: none;
  ]

  body [
    background: #ffffff;
    color: #000000;
    font-size: 12pt;
  ]

  .main [
    max-width: none;
    padding: 0;
  ]

  a [
    color: #000000;
    text-decoration: none;
  ]

  /* Keep a heading with the text it introduces, and keep a code block or a
     table on one page instead of splitting it across two. */
  h1, h2, h3, h4 [
    break-after: avoid;
  ]

  pre, blockquote, table [
    break-inside: avoid;
  ]

  pre [
    border-color: #cccccc;
  ]
]

@media (prefers-reduced-motion: reduce) [
  * [
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  ]
]
