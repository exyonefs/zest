<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- .NET Tool packaging
         Installed via:  dotnet tool install -g zest
         Invoked via:    zest <command>
         PackAsTool places the output under the tool manifest layout
         so `dotnet tool install` works against the produced .nupkg.
         ToolCommandName=zest keeps the CLI command name short.
         PackageId=zest matches the .NET tool naming convention
         (lowercase, like dotnet-ef / powershell / dotnet-outdated). -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>zest</ToolCommandName>
    <PackageId>zest</PackageId>
    <IsPackable>true</IsPackable>

    <!-- Framework-dependent deployment (FSI needs assemblies on disk).
         No RID is set so the tool is platform-neutral and runs on any
         .NET 10 runtime (win/linux/osx). The previous win-x64 hard-coding
         blocked `dotnet tool install` on non-Windows hosts. -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <AssemblyName>zest</AssemblyName>
    <DebugType>embedded</DebugType>

    <!-- Publish trimming: exclude unused files -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <TrimMode>partial</TrimMode>

    <!-- App icon -->
    <ApplicationIcon>..\..\zest.ico</ApplicationIcon>

    <!-- Pack README + icon into the .nupkg so nuget.org shows them.
         The files live at repo root; PackFolderInclude keeps them
         at the package root for NuGet's metadata conventions. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>zest.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zest.Compiler\Zest.Compiler.fsproj" />
    <ProjectReference Include="..\Zest.Markup\Zest.Markup.fsproj" />
  </ItemGroup>

  <!-- CLI branding and help text live in .config/zest/, split by concern:
       meta.toml (name, version, tagline) and help.toml (help copy). Both are
       embedded as resources so the tool works immediately after
       `dotnet tool install` without needing to locate them on disk.
       HelpRenderer merges them and falls back to the files on disk during
       local development. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\.config\zest\meta.toml">
      <LogicalName>zest.meta.toml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\.config\zest\help.toml">
      <LogicalName>zest.help.toml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Bundled `zest init` starter site. Every file is listed explicitly so the
       shipped manifest is self-documenting; LogicalName preserves the relative
       path (using backslashes) so InitCommand can reconstruct file paths at
       runtime. `Starters` is the scaffold copied out by init; it is not the
       runtime template engine (which lives in Zest.Compiler/Template). -->
  <ItemGroup>
    <None Remove="Starter\**\*" />
    <EmbeddedResource Include="Starter\_config.toml" LogicalName="Zest.App.Starter._config.toml" />
    <EmbeddedResource Include="Starter\_prebuild.fsx" LogicalName="Zest.App.Starter._prebuild.fsx" />
    <EmbeddedResource Include="Starter\_finalize.fsx" LogicalName="Zest.App.Starter._finalize.fsx" />
    <EmbeddedResource Include="Starter\README.md" LogicalName="Zest.App.Starter.README.md" />
    <EmbeddedResource Include="Starter\assets\css\style.zcss" LogicalName="Zest.App.Starter.assets\css\style.zcss" />
    <EmbeddedResource Include="Starter\_layouts\default.html" LogicalName="Zest.App.Starter._layouts\default.html" />
    <EmbeddedResource Include="Starter\_layouts\post.html" LogicalName="Zest.App.Starter._layouts\post.html" />
    <EmbeddedResource Include="Starter\_layouts\shell.html" LogicalName="Zest.App.Starter._layouts\shell.html" />
    <EmbeddedResource Include="Starter\_layouts\tag.html" LogicalName="Zest.App.Starter._layouts\tag.html" />
    <EmbeddedResource Include="Starter\_layouts\tags.html" LogicalName="Zest.App.Starter._layouts\tags.html" />
    <EmbeddedResource Include="Starter\_layouts\category.html" LogicalName="Zest.App.Starter._layouts\category.html" />
    <EmbeddedResource Include="Starter\_layouts\categories.html" LogicalName="Zest.App.Starter._layouts\categories.html" />
    <EmbeddedResource Include="Starter\_includes\header.html" LogicalName="Zest.App.Starter._includes\header.html" />
    <EmbeddedResource Include="Starter\_includes\footer.html" LogicalName="Zest.App.Starter._includes\footer.html" />
    <EmbeddedResource Include="Starter\_includes\post-list.html" LogicalName="Zest.App.Starter._includes\post-list.html" />
    <EmbeddedResource Include="Starter\_includes\pager.html" LogicalName="Zest.App.Starter._includes\pager.html" />
    <EmbeddedResource Include="Starter\content\index.zest.fsx" LogicalName="Zest.App.Starter.content\index.zest.fsx" />
    <EmbeddedResource Include="Starter\content\about.md" LogicalName="Zest.App.Starter.content\about.md" />
    <EmbeddedResource Include="Starter\content\archive.zest.fsx" LogicalName="Zest.App.Starter.content\archive.zest.fsx" />
    <EmbeddedResource Include="Starter\content\404.md" LogicalName="Zest.App.Starter.content\404.md" />
    <EmbeddedResource Include="Starter\content\feed.zest.fsx" LogicalName="Zest.App.Starter.content\feed.zest.fsx" />
    <EmbeddedResource Include="Starter\content\atom.zest.fsx" LogicalName="Zest.App.Starter.content\atom.zest.fsx" />
    <EmbeddedResource Include="Starter\content\robots.zest.fsx" LogicalName="Zest.App.Starter.content\robots.zest.fsx" />
    <EmbeddedResource Include="Starter\content\sitemap.zest.fsx" LogicalName="Zest.App.Starter.content\sitemap.zest.fsx" />
    <EmbeddedResource Include="Starter\content\posts\2026-02-14-why-static.md" LogicalName="Zest.App.Starter.content\posts\2026-02-14-why-static.md" />
    <EmbeddedResource Include="Starter\content\posts\2026-03-08-the-shape-of-a-url.md" LogicalName="Zest.App.Starter.content\posts\2026-03-08-the-shape-of-a-url.md" />
    <EmbeddedResource Include="Starter\content\posts\2026-04-19-the-measure-of-a-page.md" LogicalName="Zest.App.Starter.content\posts\2026-04-19-the-measure-of-a-page.md" />
    <EmbeddedResource Include="Starter\content\posts\2026-05-24-when-a-blog-outgrows-its-index.md" LogicalName="Zest.App.Starter.content\posts\2026-05-24-when-a-blog-outgrows-its-index.md" />
    <EmbeddedResource Include="Starter\content\posts\2026-06-30-static-by-design.md" LogicalName="Zest.App.Starter.content\posts\2026-06-30-static-by-design.md" />
    <EmbeddedResource Include="Starter\content\posts\2026-07-21-writing-in-markdown.md" LogicalName="Zest.App.Starter.content\posts\2026-07-21-writing-in-markdown.md" />
    <EmbeddedResource Include="Starter\content\posts\2026-08-02-welcome-to-zest.md" LogicalName="Zest.App.Starter.content\posts\2026-08-02-welcome-to-zest.md" />
  </ItemGroup>

  <!-- Package icon + README at the nupkg root (NuGet metadata convention). -->
  <ItemGroup>
    <None Include="..\..\zest.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Exclude unused files from publish output -->
  <ItemGroup>
    <!-- Remove satellite resource assemblies (empty locale folders) -->
    <SatelliteAssemblies Remove="@(SatelliteAssemblies)" />
    <!-- Exclude XML documentation files -->
    <None Remove="**\*.xml" />
    <None Remove="**\*.pdb" />
    <!-- Exclude source files from publish -->
    <None Remove="**\*.fs" />
    <None Remove="**\*.fsi" />
    <None Remove="**\*.fsproj" />
    <None Remove="**\*.cs" />
    <None Remove="**\*.csproj" />
  </ItemGroup>

</Project>
